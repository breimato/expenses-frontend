# Copia a .env.deploy.local y rellena (no commitear)
FTP_HOST=ftp.breimato.es
FTP_USER=usuario@breimato.es
FTP_PASSWORD=
FTP_PORT=21
FTP_REMOTE_DIR=breimato.es/public_html/cuaderno
FTP_SECURE=false

VITE_BASE_PATH=/cuaderno/
# URL pública HTTPS del backend (túnel Cloudflare/ngrok hacia tu PC, o hosting cloud)
VITE_API_URL=https://your-tunnel.trycloudflare.com
